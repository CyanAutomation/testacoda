{
  "name": "testacoda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Daily public GitHub repository maturity scanner",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit && wrangler types --check worker-configuration.d.ts",
    "check": "npm test && npm run typecheck && wrangler deploy --dry-run"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fallow": "^3.47.0",
    "typescript": "5.8.3",
    "wrangler": "4.158.0"
  }
}
